HOST=127.0.0.1
PORT=3002
LOG_LEVEL=info

# Comma-separated origins. Leave empty when nginx exposes this API on the
# application's own origin. Set this when browsers call the service directly.
ALLOWED_ORIGINS=
TRUST_PROXY=false

REQUEST_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=5242880
MAX_REDIRECTS=5
UPSTREAM_USER_AGENT=MediaFinderExtractor/1.0

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=200

# Chromium is an optional fallback for challenged or JavaScript-rendered pages.
BROWSER_ENABLED=false
BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
BROWSER_TIMEOUT_MS=25000
BROWSER_MAX_CONCURRENCY=2
BROWSER_PROXY_SERVER=
BROWSER_PROXY_USERNAME=
BROWSER_PROXY_PASSWORD=
BROWSER_DISABLE_SANDBOX=false

# Optional comma-separated exact hosts or wildcard suffixes such as *.example.com.
# When set, browser fallback is used only for matching page hosts.
BROWSER_ALLOWED_HOSTS=
